#!/usr/bin/env bash
set -euo pipefail

buildType="debug"

while [[ $# -gt 0 ]]; do
  case $1 in
  -r | --release)
    buildType="release"
    shift
    ;;
  *)
    shift # past argument
    ;;
  esac
done

package="au.com.shiftyjelly.pocketcasts"
if [ "$buildType" = "debug" ]; then
  package="${package}.debug"
fi

adb-all shell am start -n "$package/au.com.shiftyjelly.pocketcasts.ui.MainActivity" 1>/dev/null 2>&1
