#!/usr/bin/env bash
set -euo pipefail

username="${POCKET_CASTS_USERNAME:-}"
password="${POCKET_CASTS_PASSWORD:-}"

while getopts ":u:p:" opt; do
  case $opt in
  u)
    username="$OPTARG"
    ;;
  p)
    password="$OPTARG"
    ;;
  *)
    echo "Invalid flag $opt"
    exit 1
    ;;
  esac
done

if [[ -z "$username" ]]; then
  echo "POCKET_CASTS_USERNAME must be set or -u must be provided" >&2
  exit 1
fi

if [[ -z "$password" ]]; then
  echo "POCKET_CASTS_PASSWORD must be set or -p must be provided" >&2
  exit 1
fi

adb-all shell input keyevent 61
adb-all shell input keyevent 61
adb-all shell input text "$username"
adb-all shell input keyevent 61
adb-all shell input text "$password"
adb-all shell input keyevent 66
