#!/usr/bin/env python3
from __future__ import annotations

import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from enum import StrEnum
from pathlib import Path
from typing import NoReturn


class FormulaType(StrEnum):
    TAP = "tap"
    BREW = "brew"
    CASK = "cask"
    NPM = "npm"

    @property
    def order(self) -> int:
        match self:
            case FormulaType.TAP:
                return 1
            case FormulaType.BREW:
                return 2
            case FormulaType.CASK:
                return 3
            case FormulaType.NPM:
                return 4


@dataclass(frozen=True)
class Formula:
    type: FormulaType
    value: str
    comment: str | None = None

    @property
    def entry(self) -> str:
        return f"{self.type.value} {self.value}"

    @property
    def key(self) -> tuple[FormulaType, str]:
        return self.type, self.name

    @property
    def name(self) -> str:
        if not self.value.startswith('"'):
            fail(f"Malformed Brewfile formula: {self.entry}")

        closing_quote = self.value.find('"', 1)

        if closing_quote <= 1:
            fail(f"Malformed Brewfile formula: {self.entry}")

        return self.value[1:closing_quote]

    @property
    def sort_key(self) -> tuple[int, str]:
        return self.type.order, self.entry

    def print(self) -> str:
        match self.comment:
            case None:
                return self.entry
            case comment:
                return f"{comment}\n{self.entry}"


@dataclass(frozen=True)
class Brewfiles:
    common: list[Formula]
    profile: list[Formula]
    inactive: list[Formula]

    @property
    def tracked(self) -> list[Formula]:
        return [*self.common, *self.profile]


class Profile(StrEnum):
    HOME = "home"
    WORK = "work"

    def other(self) -> Profile:
        match self:
            case Profile.HOME:
                return Profile.WORK
            case Profile.WORK:
                return Profile.HOME


@dataclass(frozen=True)
class Config:
    dry_run: bool
    profile: Profile
    brewfile_dir: Path

    @property
    def common_file(self) -> Path:
        return self.brewfile_dir / "common"

    @property
    def profile_file(self) -> Path:
        return self.brewfile_dir / self.profile.value

    @property
    def inactive_file(self) -> Path:
        return self.brewfile_dir / self.profile.other().value

    @property
    def tracked_files(self) -> list[Path]:
        return [self.common_file, self.profile_file, self.inactive_file]


def main(argv: list[str]) -> int:
    print("Preparing Homebrew diff...")
    config = load_config(argv)
    brewfiles = read_current_brewfiles(config)
    current_formulas = read_homebrew_formulas()
    new_formulas, removed_formulas = diff_formulas(brewfiles.tracked, current_formulas)
    new_common_formulas, new_profile_formulas = partition_formulas(
        config.profile,
        new_formulas,
    )
    updated_brewfiles = create_updated_brewfiles(
        brewfiles,
        current_formulas,
        removed_formulas,
        new_common_formulas,
        new_profile_formulas,
    )

    dump_brewfiles(config, brewfiles, updated_brewfiles)

    return 0


def diff_formulas(
    tracked_formulas: list[Formula],
    current_formulas: list[Formula],
) -> tuple[list[Formula], list[Formula]]:
    tracked_keys = formula_keys(tracked_formulas)
    current_keys = formula_keys(current_formulas)

    new_formulas = [
        formula for formula in current_formulas if formula.key not in tracked_keys
    ]
    removed_formulas = [
        formula for formula in tracked_formulas if formula.key not in current_keys
    ]

    return new_formulas, removed_formulas


def partition_formulas(
    profile: Profile,
    formulas: list[Formula],
) -> tuple[list[Formula], list[Formula]]:
    if not formulas:
        return [], []

    sorted_formulas = sorted(formulas, key=lambda formula: formula.sort_key)
    choices = [formula.entry for formula in sorted_formulas]
    result = subprocess.run(
        [
            "gum",
            "choose",
            "--no-limit",
            "--header",
            f"Select entries for {profile.value}. Unselected entries go to common.",
            *choices,
        ],
        check=False,
        stdout=subprocess.PIPE,
        text=True,
    )

    if result.returncode != 0:
        fail("Selection cancelled")

    selected_entries = {line for line in result.stdout.splitlines() if line}
    common_formulas = [
        formula for formula in sorted_formulas if formula.entry not in selected_entries
    ]
    profile_formulas = [
        formula for formula in sorted_formulas if formula.entry in selected_entries
    ]

    return common_formulas, profile_formulas


def create_updated_brewfiles(
    brewfiles: Brewfiles,
    current_formulas: list[Formula],
    removed_formulas: list[Formula],
    new_common_formulas: list[Formula],
    new_profile_formulas: list[Formula],
) -> Brewfiles:
    current_by_key = {
        formula.key: formula for formula in unique_formulas(current_formulas)
    }
    removed_keys = formula_keys(removed_formulas)
    common_formulas = [
        current_by_key.get(formula.key, formula)
        for formula in brewfiles.common
        if formula.key not in removed_keys
    ]
    profile_formulas = [
        current_by_key.get(formula.key, formula)
        for formula in brewfiles.profile
        if formula.key not in removed_keys
    ]

    common_formulas = sorted(
        unique_formulas([*common_formulas, *new_common_formulas]),
        key=lambda formula: formula.sort_key,
    )
    profile_formulas = sorted(
        unique_formulas([*profile_formulas, *new_profile_formulas]),
        key=lambda formula: formula.sort_key,
    )

    common_keys = formula_keys(common_formulas)
    inactive_formulas = sorted(
        unique_formulas(
            [
                formula
                for formula in brewfiles.inactive
                if formula.key not in common_keys
            ]
        ),
        key=lambda formula: formula.sort_key,
    )

    return Brewfiles(
        common=common_formulas,
        profile=profile_formulas,
        inactive=inactive_formulas,
    )


def dump_brewfiles(
    config: Config,
    brewfiles: Brewfiles,
    updated_brewfiles: Brewfiles,
) -> None:
    has_changes = report_output(config.profile, brewfiles, updated_brewfiles)

    if config.dry_run:
        return

    if not has_changes or confirm_changes():
        save_brewfiles(config, updated_brewfiles)
    else:
        print("Brewfiles update cancelled.")


def report_output(
    profile: Profile,
    brewfiles: Brewfiles,
    updated_brewfiles: Brewfiles,
) -> bool:
    print()

    common_additions = added_formulas(brewfiles.common, updated_brewfiles.common)
    profile_additions = added_formulas(brewfiles.profile, updated_brewfiles.profile)
    common_removals = removed_formulas(brewfiles.common, updated_brewfiles.common)
    profile_removals = removed_formulas(brewfiles.profile, updated_brewfiles.profile)
    inactive_removals = removed_formulas(
        brewfiles.inactive,
        updated_brewfiles.inactive,
    )

    if (
        not common_additions
        and not profile_additions
        and not common_removals
        and not profile_removals
        and not inactive_removals
    ):
        print("No Homebrew entries to add or remove.")
        return False

    printed_section = False

    def print_section(header: str, formulas: list[Formula]) -> None:
        nonlocal printed_section

        if not formulas:
            return

        if printed_section:
            print()

        print(header)

        for formula in sorted(formulas, key=lambda formula: formula.sort_key):
            print(formula.entry)

        printed_section = True

    print_section(f"Add to {profile.value}:", profile_additions)
    print_section("Add to common:", common_additions)
    print_section(f"Remove from {profile.value}:", profile_removals)
    print_section("Remove from common:", common_removals)
    print_section("Remove from inactive:", inactive_removals)

    return True


def save_brewfiles(config: Config, brewfiles: Brewfiles) -> None:
    outputs = [
        (config.common_file, brewfiles.common),
        (config.profile_file, brewfiles.profile),
        (config.inactive_file, brewfiles.inactive),
    ]

    for path, formulas in outputs:
        with path.open("w", encoding="utf-8", newline="\n") as file:
            file.write(render_formulas(formulas))


def confirm_changes() -> bool:
    print()

    result = subprocess.run(
        ["gum", "confirm", "--default", "Apply these Brewfile changes?"],
        check=False,
    )

    return result.returncode == 0


def render_formulas(formulas: list[Formula]) -> str:
    output: list[str] = []
    previous_order: int | None = None

    for formula in formulas:
        order = formula.type.order

        if previous_order is not None and order != previous_order:
            output.append("\n")

        output.append(f"{formula.print()}\n")
        previous_order = order

    if not output:
        return "\n"

    return "".join(output)


def added_formulas(
    old_formulas: list[Formula],
    new_formulas: list[Formula],
) -> list[Formula]:
    old_keys = formula_keys(old_formulas)

    return [formula for formula in new_formulas if formula.key not in old_keys]


def removed_formulas(
    old_formulas: list[Formula],
    new_formulas: list[Formula],
) -> list[Formula]:
    new_keys = formula_keys(new_formulas)

    return [formula for formula in old_formulas if formula.key not in new_keys]


def read_current_brewfiles(config: Config) -> Brewfiles:
    return Brewfiles(
        common=read_formulas(config.common_file),
        profile=read_formulas(config.profile_file),
        inactive=read_formulas(config.inactive_file),
    )


def read_homebrew_formulas() -> list[Formula]:
    output = run_command(
        [
            "brew",
            "bundle",
            "--file=-",
            "--force",
            "dump",
        ]
    )
    return parse_formulas(output, "brew dump")


def read_formulas(path: Path) -> list[Formula]:
    return parse_formulas(path.read_text(encoding="utf-8"), str(path))


def parse_formulas(content: str, source_name: str) -> list[Formula]:
    formulas: list[Formula] = []
    comment_lines: list[str] = []

    for line_number, line in enumerate(content.splitlines(), 1):
        entry = line.strip()

        if not entry:
            continue

        if entry.startswith("#"):
            comment_lines.append(line)
            continue

        match entry.split(maxsplit=1):
            case [formula_type_name, value]:
                pass
            case _:
                fail(f"Malformed formula at {source_name}:{line_number}: {line}")

        try:
            formula_type = FormulaType(formula_type_name)
        except ValueError:
            fail(f"Unsupported Brewfile line at {source_name}:{line_number}: {line}")

        formulas.append(
            Formula(
                type=formula_type,
                value=value,
                comment="\n".join(comment_lines) if comment_lines else None,
            )
        )
        comment_lines = []

    if comment_lines:
        fail(f"{source_name} ended with comments not attached to a formula")

    return formulas


def formula_keys(formulas: list[Formula]) -> set[tuple[FormulaType, str]]:
    return {formula.key for formula in formulas}


def unique_formulas(formulas: list[Formula]) -> list[Formula]:
    unique_by_key: dict[tuple[FormulaType, str], Formula] = {}

    for formula in formulas:
        unique_by_key.setdefault(formula.key, formula)

    return list(unique_by_key.values())


def load_config(argv: list[str]) -> Config:
    match argv:
        case []:
            dry_run = False
        case ["--dry-run"]:
            dry_run = True
        case [arg]:
            fail(f"Unsupported argument: {arg}. Expected --dry-run.")
        case _:
            fail("bdump accepts only one argument: --dry-run")

    xdg_config_home = os.environ.get("XDG_CONFIG_HOME")
    profile_name = os.environ.get("DOTFILES_PROFILE")

    if not xdg_config_home:
        fail("XDG_CONFIG_HOME is not set")

    if not profile_name:
        fail("DOTFILES_PROFILE is not set. Expected 'home' or 'work'.")

    try:
        profile = Profile(profile_name)
    except ValueError:
        fail(f"Invalid DOTFILES_PROFILE={profile_name}. Expected 'home' or 'work'.")

    if shutil.which("brew") is None:
        fail("brew not found")

    if shutil.which("gum") is None:
        fail("gum not found")

    brewfile_dir = Path(xdg_config_home) / "homebrew"
    config = Config(
        dry_run=dry_run,
        profile=profile,
        brewfile_dir=brewfile_dir,
    )

    if not brewfile_dir.is_dir():
        fail(f"Homebrew config directory not found: {brewfile_dir}")

    if not os.access(brewfile_dir, os.W_OK | os.X_OK):
        fail(f"Directory is not writable: {brewfile_dir}")

    for tracked_file in config.tracked_files:
        if not tracked_file.is_file():
            fail(f"Brewfile not found: {tracked_file}")

        if not os.access(tracked_file, os.R_OK | os.W_OK):
            fail(f"Brewfile is not readable and writable: {tracked_file}")

    return config


def run_command(command: list[str]) -> str:
    result = subprocess.run(
        command,
        check=False,
        stdout=subprocess.PIPE,
        text=True,
    )

    if result.returncode != 0:
        raise SystemExit(result.returncode)

    return result.stdout


def fail(message: str) -> NoReturn:
    print(message, file=sys.stderr)
    raise SystemExit(1)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print("Interrupted", file=sys.stderr)
        raise SystemExit(130)
