#!/usr/bin/env bash

buildType="debug"

while [[ $# -gt 0 ]]; do
  case $1 in
  -r | --release)
    buildType="release"
    shift
    ;;
  *)
    shift # past argument
    ;;
  esac
done

package="au.com.shiftyjelly.pocketcasts"
if [ "$buildType" = "debug" ]; then
  package="${package}.debug"
fi

adb-all shell pm clear "$package"
