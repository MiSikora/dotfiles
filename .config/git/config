[user]
	name = Michał Sikora
	email = me@mehow.io
	signingkey = 533F4DBAF854E83C
[core]
	autocrlf = input
	pager = delta
	editor = nvim
[init]
	defaultBranch = trunk
[commit]
	gpgsign = true
	verbose = true
[credential]
	helper = osxkeychain
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictStyle = zdiff3
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[rerere]
	enabled = true
	autoupdate = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[push]
	autoSetupRemote = true
[fetch]
	prune = true
	pruneTags = true
[pull]
	rebase = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
[tag]
	sort = version:refname
	gpgSign = true
[help]
	autocorrect = prompt
