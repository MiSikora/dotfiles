#!/usr/bin/env bash
set -euo pipefail

PROJECTS_DIR="$HOME/projects"

_tmux_session_usage() {
  printf '%s\n' \
    'Usage:' \
    '  tmux_session list' \
    '    Print projects as label<TAB>absolute_path.' \
    '  tmux_session pick' \
    '    Open fzf and switch to the selected project session.' \
    '  tmux_session switch <absolute-path>' \
    '    Create or switch to the tmux session for a project path.'
}

_tmux_session_list() {
  local project_entries=''
  local dotfiles_entries=''

  _tmux_session_print_entries() {
    local source_entries=$1

    if [[ -z $source_entries ]]; then
      return 0
    fi

    printf '%s' "$source_entries" | sort -f -t $'\t' -k1,1 -k2,2
  }

  if [[ ! -d $PROJECTS_DIR && ! -d $HOME/.config && ! -d $HOME/.local/bin ]]; then
    return 0
  fi

  while IFS= read -r project_path; do
    local label

    if [[ -z $project_path ]]; then
      continue
    fi

    project_path=${project_path%/}
    if [[ ! -d $project_path ]]; then
      continue
    fi

    label=$(_tmux_session_project_label "$project_path")
    if [[ -z $label ]]; then
      continue
    fi

    project_entries+="$label"$'\t'"$project_path"$'\n'
  done < <(
    {
      if [[ -d $PROJECTS_DIR ]]; then
        fd -t d -d 1 -E "*.git" . "$PROJECTS_DIR" 2>/dev/null || true
      fi
    }
  )

  if [[ -d $HOME/.local/bin ]]; then
    dotfiles_entries+='dotfiles-bin'$'\t'"$HOME/.local/bin"$'\n'
  fi

  if [[ -d $HOME/.config ]]; then
    dotfiles_entries+='dotfiles-config'$'\t'"$HOME/.config"$'\n'
  fi

  if [[ -d $HOME ]]; then
    dotfiles_entries+='dotfiles-home'$'\t'"$HOME"$'\n'
  fi

  _tmux_session_print_entries "$project_entries"
  _tmux_session_print_entries "$dotfiles_entries"
}

_tmux_session_project_label() {
  local selected_path=$1

  case $selected_path in
  "$HOME/.local/bin")
    echo 'dotfiles-bin'
    ;;
  "$HOME/.config")
    echo 'dotfiles-config'
    ;;
  "$HOME")
    echo 'dotfiles-home'
    ;;
  "$PROJECTS_DIR"/*)
    echo "${selected_path#"$PROJECTS_DIR"/}"
    ;;
  esac
}

_tmux_session_known_label() {
  local selected_path=$1
  local entry
  local label
  local project_path
  local canonical_path

  while IFS= read -r entry; do
    if [[ -z $entry ]]; then
      continue
    fi

    label=${entry%%$'\t'*}
    project_path=${entry#*$'\t'}
    canonical_path=$(cd "$project_path" && pwd -P)

    if [[ $canonical_path == "$selected_path" ]]; then
      echo "$label"
      return 0
    fi
  done < <(_tmux_session_list)
}

_tmux_session_sanitize_name() {
  echo -n "$1" | tr '/.' '--' | tr -cs '[:alnum:]_-' '-'
}

_tmux_session_external_name() {
  local canonical_path=$1
  local short_hash
  local base_name
  local sanitized_base

  short_hash=$(printf '%s' "$canonical_path" | shasum -a 256 | cut -c1-8)
  base_name=$(basename "$canonical_path")
  sanitized_base=$(_tmux_session_sanitize_name "$base_name")

  echo "ext-${sanitized_base:-path}-$short_hash"
}

_tmux_session_session_name() {
  local selected_path=$1
  local label
  local sanitized_label

  label=$(_tmux_session_known_label "$selected_path")

  if [[ -n $label ]]; then
    sanitized_label=$(_tmux_session_sanitize_name "$label")
    echo "${sanitized_label%-}"
    return 0
  fi

  _tmux_session_external_name "$selected_path"
}

_tmux_session_switch() {
  if [[ $# -ne 1 ]]; then
    printf 'tmux_session switch requires exactly one path\n' >&2
    return 1
  fi

  local selected_path=$1
  local canonical_path
  local selected_name
  local tmux_running

  if [[ $selected_path != /* ]]; then
    printf 'tmux_session switch requires an absolute path\n' >&2
    return 1
  fi

  if [[ ! -d $selected_path ]]; then
    printf 'tmux_session switch target is not a directory: %s\n' "$selected_path" >&2
    return 1
  fi

  canonical_path=$(cd "$selected_path" && pwd -P)
  selected_name=$(_tmux_session_session_name "$canonical_path")
  tmux_running=$(pgrep tmux || true)

  if [[ -z ${TMUX:-} && -z $tmux_running ]]; then
    exec tmux new -s "$selected_name" -c "$canonical_path"
  fi

  if ! tmux has -t="$selected_name" 2>/dev/null; then
    tmux new -d -s "$selected_name" -c "$canonical_path"
  fi

  if [[ -n ${TMUX:-} ]]; then
    tmux switchc -t "$selected_name"
  else
    exec tmux attach -t "$selected_name"
  fi
}

_tmux_session_pick() {
  local selection
  local selected_path

  selection=$(_tmux_session_list | fzf --layout=reverse --delimiter=$'\t' --with-nth=1) || return 0
  if [[ -z $selection ]]; then
    return 0
  fi

  selected_path=${selection#*$'\t'}
  _tmux_session_switch "$selected_path"
}

_tmux_session_main() {
  if [[ $# -eq 0 ]]; then
    _tmux_session_usage >&2
    return 1
  fi

  case $1 in
  list)
    if [[ $# -ne 1 ]]; then
      _tmux_session_usage >&2
      return 1
    fi
    _tmux_session_list
    ;;
  pick)
    if [[ $# -ne 1 ]]; then
      _tmux_session_usage >&2
      return 1
    fi
    _tmux_session_pick
    ;;
  switch)
    if [[ $# -ne 2 ]]; then
      _tmux_session_usage >&2
      return 1
    fi
    _tmux_session_switch "$2"
    ;;
  *)
    _tmux_session_usage >&2
    return 1
    ;;
  esac
}

_tmux_session_main "$@"
