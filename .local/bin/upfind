#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <filename>" >&2
  exit 1
fi

target="$1"
dir="$(pwd)"

while true; do
  match=$(find "$dir" -maxdepth 1 -name "$target" -print -quit 2>/dev/null)

  if [[ -n "$match" ]]; then
    echo "$match"
    exit 0
  fi

  if [[ "$dir" == "/" ]]; then
    break
  fi

  dir="$(dirname "$dir")"
done

echo "$target not found" >&2
exit 1
