#!/usr/bin/env bash

username="$POCKET_CASTS_USERNAME"
password="$POCKET_CASTS_PASSWORD"

while getopts ":u:p:" opt; do
  case $opt in
  u)
    username="$OPTARG"
    ;;
  p)
    password="$OPTARG"
    ;;
  esac
done

adb-all shell input text "$username"
adb-all shell input keyevent 61
adb-all shell input text "$password"
