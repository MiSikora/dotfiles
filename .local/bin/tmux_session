#!/usr/bin/env bash

PROJECTS_DIR="$HOME/projects"

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(
    {
      fd -t d -d 1 -E "*.git" -E a8c . "$PROJECTS_DIR"
      fd -t d -d 1 . "$PROJECTS_DIR/a8c"
    } | rg "^$PROJECTS_DIR/(.*)/$" -r '$1' |
      fzf --layout=reverse
  )
fi

if [[ -z $selected ]]; then
  exit 0
fi

if [[ $# -ne 1 ]]; then
  selected="$PROJECTS_DIR/$selected"
fi

if [[ ! -d $selected ]]; then
  exit 0
fi

if [[ "$selected" == "$HOME" ]]; then
  selected_name="home"
else
  selected_name=$(basename "$selected" | tr . _)
fi

tmux_running=$(pgrep tmux)

if [[ -z $TMUX && -z $tmux_running ]]; then
  exec tmux new -s "$selected_name" -c "$selected"
fi

if ! tmux has -t="$selected_name" 2>/dev/null; then
  tmux new -d -s "$selected_name" -c "$selected"
fi

if [[ -n $TMUX ]]; then
  tmux switchc -t "$selected_name"
else
  exec tmux attach -t "$selected_name"
fi
