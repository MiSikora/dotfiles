#!/usr/bin/env bash
set -euo pipefail

adb-all shell <<'EOF' 2>/dev/null || true
  run-as au.com.shiftyjelly.pocketcasts.debug
  cd /data/data/au.com.shiftyjelly.pocketcasts.debug
  mkdir -p shared_prefs
  cd shared_prefs

  if grep -q 'name="SendUsageStatsKey"' au.com.shiftyjelly.pocketcasts.debug_preferences.xml 2>/dev/null; then
    echo "Shared preferences already initialized. Skipping…"
    exit 0
  fi

  echo '<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<map>
    <boolean name="SendUsageStatsKey" value="false" />
    <boolean name="SendCrashReportsKey" value="false" />
    <boolean name="CompletedOnboardingKey" value="true" />
    <boolean name="autoDownloadOnFollowPodcast" value="false" />
</map>' > au.com.shiftyjelly.pocketcasts.debug_preferences.xml
EOF
