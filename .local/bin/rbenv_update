#!/usr/bin/env bash
set -euo pipefail

if [[ -z ${XDG_CONFIG_HOME:-} ]]; then
  echo "XDG_CONFIG_HOME must be set" >&2
  exit 1
fi

version_file="$XDG_CONFIG_HOME/rbenv/version"

if [[ $# -ge 1 ]]; then
  ruby_version="$1"
elif [[ -r "$version_file" ]]; then
  ruby_version="$(<"$version_file")"
else
  echo "Usage: $0 [ruby_version] (defaults to $version_file)" >&2
  exit 1
fi

if [[ $(rbenv version-name global) == "$ruby_version" ]]; then
  echo "Ruby version already set to $ruby_version"
  exit 0
fi

# Install the specified Ruby version
rbenv install "$ruby_version"
rbenv global "$ruby_version"
rbenv rehash

# Save the version to the version file
echo "$ruby_version" >"$version_file"

echo "Ruby $ruby_version installation complete"
