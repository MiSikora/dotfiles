#!/usr/bin/env bash
set -euo pipefail

if [[ -z ${XDG_CONFIG_HOME:-} ]]; then
  echo "XDG_CONFIG_HOME must be set" >&2
  exit 1
fi

version_file="$XDG_CONFIG_HOME/nvm/version"

if [[ $# -ge 1 ]]; then
  node_version="$1"
elif [[ -r "$version_file" ]]; then
  node_version="$(<"$version_file")"
else
  echo "Usage: $0 [node_version] (defaults to $version_file)" >&2
  exit 1
fi

if [[ -z ${HOMEBREW_PREFIX:-} ]]; then
  echo "HOMEBREW_PREFIX must be set" >&2
  exit 1
fi

export NVM_DIR="$HOME/.nvm"
[ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ] && \. "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
[ -s "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm" ] && \. "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm"

if [[ $(nvm alias default) == *"$node_version"* ]]; then
  echo "Node version already set to $node_version"
  exit 0
fi

# Install the specified Node version, carrying global packages over from the current default
if previous_version="$(nvm version default 2>/dev/null)" && [[ "$previous_version" != "N/A" ]]; then
  nvm install "$node_version" --reinstall-packages-from="$previous_version"
else
  nvm install "$node_version"
fi
nvm alias default "$node_version"

# Save the version to the version file
echo "$node_version" >"$version_file"

echo "Node $node_version installation complete"
