#!/usr/bin/env bash
set -euo pipefail

shopt -s extglob

# Add newly installed Homebrew entries to the split Brewfiles without touching
# the profile-aware loader.

fail() {
  printf "%s\n" "$1" >&2
  exit 1
}

# Strip surrounding whitespace before matching Brewfile declarations.
trim() {
  local value="$1"
  value="${value##+([[:space:]])}"
  value="${value%%+([[:space:]])}"
  printf "%s" "$value"
}

# Accept declaration types that brew bundle can dump and this script can sort.
is_declaration() {
  case "$1" in
  tap[[:space:]]* | brew[[:space:]]* | cask[[:space:]]* | mas[[:space:]]* | vscode[[:space:]]*)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

# Use the quoted package name in prompts instead of the full declaration.
entry_name() {
  local declaration="$1"
  local rest="${declaration#*\"}"

  if [[ "$rest" == "$declaration" ]]; then
    printf "%s" "$declaration"
    return
  fi

  printf "%s" "${rest%%\"*}"
}

# Skip entries that are already managed by any split Brewfile.
has_declaration() {
  local needle="$1"
  local declaration

  for declaration in "${managed_declarations[@]}"; do
    [[ "$declaration" == "$needle" ]] && return 0
  done

  return 1
}

# Formula dependencies are installed automatically and should not be managed here.
has_direct_formula() {
  local needle="$1"
  local formula

  for formula in "${direct_formulae[@]}"; do
    [[ "$formula" == "$needle" ]] && return 0
  done

  return 1
}

is_direct_brew_declaration() {
  local declaration="$1"
  local name=""
  local short_name=""

  [[ "$declaration" == brew[[:space:]]* ]] || return 0

  name="$(entry_name "$declaration")"
  short_name="${name##*/}"

  has_direct_formula "$name" || has_direct_formula "$short_name"
}

# Sort by Brewfile section first, then by the declaration text.
declaration_sort_key() {
  local declaration="$1"
  local type_order

  case "$declaration" in
  tap[[:space:]]*) type_order="1" ;;
  brew[[:space:]]*) type_order="2" ;;
  cask[[:space:]]*) type_order="3" ;;
  mas[[:space:]]*) type_order="4" ;;
  vscode[[:space:]]*) type_order="5" ;;
  *) type_order="9" ;;
  esac

  printf "%s %s" "$type_order" "$declaration"
}

# Parse a Brewfile into declaration blocks while preserving descriptions.
load_blocks() {
  local file="$1"
  local block=""
  local line=""
  local stripped=""

  loaded_blocks=()
  loaded_declarations=()

  # Keep comment blocks attached to the declaration they describe.
  while IFS= read -r line || [[ -n "$line" ]]; do
    stripped="$(trim "$line")"

    if [[ -z "$stripped" ]]; then
      [[ -z "$block" ]] && continue
      block+="$line"$'\n'
      continue
    fi

    if [[ "$stripped" == \#* ]]; then
      block+="$line"$'\n'
      continue
    fi

    is_declaration "$stripped" || fail "Unsupported Brewfile line: $line"

    block+="$line"$'\n'
    loaded_blocks+=("$block")
    loaded_declarations+=("$stripped")
    block=""
  done <"$file"

  [[ -z "$block" ]] || fail "Brewfile ended with comments not attached to an entry"
}

sort_brewfile() {
  local file="$1"
  local index=""
  local position=""
  local insert_at=""
  local key=""
  local existing_index=""
  local existing_key=""
  local temp_file=""

  load_blocks "$file"

  sorted_indices=()

  # Keep original blocks intact and sort only their positions.
  for index in "${!loaded_blocks[@]}"; do
    key="$(declaration_sort_key "${loaded_declarations[$index]}")"
    insert_at="${#sorted_indices[@]}"

    for position in "${!sorted_indices[@]}"; do
      existing_index="${sorted_indices[$position]}"
      existing_key="$(declaration_sort_key "${loaded_declarations[$existing_index]}")"

      if [[ "$key" < "$existing_key" ]]; then
        insert_at="$position"
        break
      fi
    done

    sorted_indices=(
      "${sorted_indices[@]:0:$insert_at}"
      "$index"
      "${sorted_indices[@]:$insert_at}"
    )
  done

  # Rewrite through a temporary file so failures do not truncate the Brewfile.
  temp_file="$(mktemp)"
  for index in "${sorted_indices[@]}"; do
    printf "%s" "${loaded_blocks[$index]}" >>"$temp_file"
  done

  mv "$temp_file" "$file"
}

# Prompt for a destination. Enter defaults to common to keep shared tools easy.
prompt_choice() {
  local choice=""

  until [[ "$choice" == "1" || "$choice" == "2" ]]; do
    printf "> " >&2
    if ! IFS= read -r choice; then
      fail "No choice provided"
    fi

    # Most new tools are expected to be shared unless explicitly profile-only.
    [[ -z "$choice" ]] && choice="1"
  done

  printf "%s" "$choice"
}

# Used by checks without running Homebrew or modifying files.
[[ "${1:-}" == "--check" ]] && exit 0
[[ -n "${XDG_CONFIG_HOME:-}" ]] || fail "XDG_CONFIG_HOME is not set"

# The current profile decides the only profile-specific destination offered.
case "${DOTFILES_PROFILE:-}" in
home | work) profile="$DOTFILES_PROFILE" ;;
"") fail "DOTFILES_PROFILE is not set. Expected 'home' or 'work'." ;;
*) fail "Invalid DOTFILES_PROFILE=$DOTFILES_PROFILE. Expected 'home' or 'work'." ;;
esac

brewfile_dir="$XDG_CONFIG_HOME/homebrew"
common_file="$brewfile_dir/common"
home_file="$brewfile_dir/home"
work_file="$brewfile_dir/work"
profile_file="$brewfile_dir/$profile"

# Fail early if the split layout is not available.
[[ -f "$common_file" ]] || fail "Brewfile not found: $common_file"
[[ -f "$home_file" ]] || fail "Brewfile not found: $home_file"
[[ -f "$work_file" ]] || fail "Brewfile not found: $work_file"

# Compare against every split file so entries are not duplicated across profiles.
managed_declarations=()
for managed_file in "$common_file" "$home_file" "$work_file"; do
  while IFS= read -r line || [[ -n "$line" ]]; do
    stripped="$(trim "$line")"
    is_declaration "$stripped" && managed_declarations+=("$stripped")
  done <"$managed_file"
done

# Homebrew can dump dependency formulae; only prompt for explicitly installed ones.
direct_formulae=()
while IFS= read -r formula || [[ -n "$formula" ]]; do
  direct_formulae+=("$formula")
done < <(brew list --formula --installed-on-request)

while IFS= read -r formula || [[ -n "$formula" ]]; do
  direct_formulae+=("$formula")
done < <(brew list --formula --installed-on-request --full-name)

dump_file="$(mktemp)"
trap 'rm -f "$dump_file"' EXIT

# Dump to a temporary file so the profile-aware loader is never overwritten.
brew bundle --file "$dump_file" --force --describe dump >/dev/null

blocks=()
declarations=()
block=""

# Keep comments from brew bundle --describe attached to their declarations.
while IFS= read -r line || [[ -n "$line" ]]; do
  stripped="$(trim "$line")"

  if [[ -z "$stripped" ]]; then
    [[ -z "$block" ]] && continue
    block+="$line"$'\n'
    continue
  fi

  if [[ "$stripped" == \#* ]]; then
    block+="$line"$'\n'
    continue
  fi

  is_declaration "$stripped" || fail "Unsupported Brewfile line: $line"

  block+="$line"$'\n'
  blocks+=("$block")
  declarations+=("$stripped")
  block=""
done <"$dump_file"

[[ -z "$block" ]] || fail "Brewfile dump ended with comments not attached to an entry"

added=0
sort_common=0
sort_profile=0

# Prompt only for entries that are installed but not yet declared anywhere.
for index in "${!blocks[@]}"; do
  declaration="${declarations[$index]}"
  has_declaration "$declaration" && continue
  is_direct_brew_declaration "$declaration" || continue

  name="$(entry_name "$declaration")"

  printf "\nNew entry:\n"
  printf "%s" "${blocks[$index]}"
  printf "\n"
  printf "Where should \"%s\" go?\n" "$name"
  printf "%s\n" "1) common (default)"
  printf "2) %s\n" "$profile"

  choice="$(prompt_choice)"

  case "$choice" in
  1)
    printf "%s" "${blocks[$index]}" >>"$common_file"
    sort_common=1
    ;;
  2)
    printf "%s" "${blocks[$index]}" >>"$profile_file"
    sort_profile=1
    ;;
  esac

  managed_declarations+=("$declaration")
  added=$((added + 1))
done

# Only rewrite files that changed during this run.
if [[ "$sort_common" -eq 1 ]]; then
  sort_brewfile "$common_file"
fi

if [[ "$sort_profile" -eq 1 ]]; then
  sort_brewfile "$profile_file"
fi

if [[ "$added" -eq 0 ]]; then
  printf "%s\n" "No new Homebrew entries found."
else
  printf "\nAdded %d Homebrew entries.\n" "$added"
fi
