#!/usr/bin/env bash
set -euo pipefail

commit="$1"
if [[ -z "$commit" ]]; then
  echo "Usage: git rebase-cherry <commit_hash>"
  exit 1
fi

git fetch -p
git pull --ff-only

current_branch=$(git rev-parse --abbrev-ref HEAD)
latest_commit=$(git rev-parse "$current_branch")

git checkout "$(git trunk)"
git pull --ff-only
git checkout -b "bak/$current_branch"
git reset --hard "$(git trunk)"
git cherry-pick "$commit"^.."$latest_commit"
git checkout "$current_branch"
git reset --hard "bak/$current_branch"
git branch -D "bak/$current_branch"
